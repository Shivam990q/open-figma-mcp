# OpenFigma MCP Environment Variables

# Figma Personal Access Token (PAT)
# Generate from: Figma Settings -> Security -> Personal Access Tokens
FIGMA_API_KEY=figd_your_personal_access_token_here

# Server Port (Default: 3845)
PORT=3845

# Server Host (Default: 127.0.0.1)
HOST=127.0.0.1

# Log Level (error, warn, info, debug, trace)
RUST_LOG=info

# Force JavaScript engine (skip native Rust binary invocation)
# OPEN_FIGMA_FORCE_JS=1
