  "description": "High-performance enterprise Model Context Protocol (MCP) server & design engine for Figma",
  "main": "src/server.js",
  "bin": {
    "open-figma": "bin/open-figma.js",
    "open-figma-mcp": "bin/open-figma.js",
    "openfigma": "bin/open-figma.js",
