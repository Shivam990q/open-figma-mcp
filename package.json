  },
  "homepage": "https://github.com/Shivam990q/open-figma-mcp#readme",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "build:rust": "cargo build --release",
    "test": "node --test tests/*.test.js",
    "test:rust": "cargo test --workspace",
    "test:sdk:ts": "node --test sdk/typescript/test/*.test.js",
    "test:all": "node --test tests/*.test.js && node --test sdk/typescript/test/*.test.js && cargo test --workspace",
    "test:token": "node tests/test_live_figma_token.js",
    "studio": "node src/server.js --open",
    "desktop": "node desktop/launch.js"
  },
  "keywords": [
